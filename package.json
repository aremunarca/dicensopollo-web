{
  "name": "dicenso-pollo",
  "version": "1.0.0",
  "private": true,
  "description": "Di Censo Pollo: carta online con pedidos por WhatsApp y panel administrativo (Next.js + Prisma + MySQL/MariaDB)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "prisma generate && next build",
    "start": "node scripts/next.mjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "catalogo:extraer": "tsx scripts/extraer-woocommerce.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "prisma": "7.10.1",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
