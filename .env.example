# Puerto de Node.js para `npm run dev` y `npm start` (por defecto 3000).
# `npm run dev -- -p 4000` tiene prioridad sobre este valor.
PORT="3000"

# Conexión a MySQL/MariaDB (formato: mysql://usuario:clave@host:puerto/base)
DATABASE_URL="mysql://root@127.0.0.1:3306/dicenso?connectionLimit=5"

# Clave para usar la API de administración desde integraciones (cabecera X-API-Key). Mínimo 24 caracteres.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si queda vacía, solo se puede administrar desde el panel.
ADMIN_API_KEY=""

# ---------- Panel administrativo (/admin) ----------
# Primer acceso: si aún no hay usuarios, se crea el gerente inicial con este usuario y contraseña
# (mínimo 8 caracteres). Después los usuarios se administran en el panel → Usuarios.
ADMIN_USER="admin"
ADMIN_PASSWORD=""

# Secreto para firmar la cookie de sesión del panel (mínimo 32 caracteres). Genera uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=""

# Tamaño máximo de cada foto subida desde el panel, en KB (las fotos se editan y comprimen en el navegador).
# Debe ser menor que max_allowed_packet de MySQL (1 MB por defecto en XAMPP).
MAX_IMAGE_KB="900"

# Dirección pública de la carta (ej.: https://dicensopollo.com). Si se define, el mensaje de WhatsApp
# de cada pedido incluye el enlace a su pantalla en el panel (/admin/pedidos/123).
# SITE_URL=""

# Si el panel se abre por http:// (sin HTTPS) desde otro equipo, pon "true" para poder iniciar sesión.
# COOKIE_INSECURE="true"
